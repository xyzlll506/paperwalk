{
  "name": "paperwalk",
  "version": "0.1.1",
  "description": "循文 · PaperWalk — full-paper preparation and guided reading with optional teaching modes.",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh/", "cordis.patch.yml", "SKILL.md", "agents/", "references/",
    "assets/", "scripts/check_readiness.py", "examples/", "evals/",
