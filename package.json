  ],
  "scripts": {
    "test": "node --test tests/dsh-plugin.test.js"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xyzlll506/paperwalk.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
